// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  super_admin
  admin
  teacher
  student
  parent
}

enum Gender {
  male
  female
}

enum SessionType {
  regular
  private
}

enum SessionStatus {
  scheduled
  in_progress
  completed // memicu charge + earning
  completed_absent // murid bolos; memicu charge + earning
  cancelled_student // murid izin/batal (privat: tanpa tagihan)
  cancelled_teacher // guru berhalangan / diliburkan
  cancelled_institution // batal karena lembaga → make-up (reguler)
  rescheduled
  excused // izin reguler disetujui
}

enum AttendanceStatus {
  present
  absent
  excused
  late
  no_info
}

enum BillingPreference {
  per_session
  monthly_bundle
}

enum InvoiceStatus {
  draft
  issued
  paid
  partial
  overdue
  void
}

enum PaymentMethod {
  transfer
  payment_gateway
  cash
  qris
}

/// Sebuah pembayaran belum tentu uang yang sudah masuk: transfer manual
/// menunggu admin melihat buktinya, Snap menunggu webhook Midtrans.
/// `pending` membuat keduanya tercatat tanpa membuat invoice ikut lunas.
enum PaymentStatus {
  pending
  verified
  rejected
}

enum ChargeStatus {
  pending
  invoiced
  void
}

enum EarningStatus {
  pending
  approved
  paid
}

enum PayoutStatus {
  requested
  approved
  paid
  rejected
}

enum TeacherRequestStatus {
  pending
  approved
  rejected
  waitlisted
}

enum LeaveType {
  short
  long
}

enum LeaveStatus {
  pending
  approved
  rejected
  active
  ended
}

enum SimpleApprovalStatus {
  pending
  approved
  rejected
}

enum Relation {
  father
  mother
  guardian
}

enum ReminderKind {
  h1 // satu jam sebelum sesi
  m5 // lima menit sebelum sesi
}

enum PrivateAssignmentStatus {
  active
  paused
  ended
}

// ===================== USER & ROLE =====================

model User {
  id                String            @id @default(uuid())
  fullName          String
  email             String?           @unique
  phone             String?           @unique
  passwordHash      String
  photoUrl          String?
  gender            Gender?
  birthDate         DateTime?
  address           String?
  timezone          String            @default("Asia/Jakarta")
  isActive          Boolean           @default(true)
  billingPreference BillingPreference @default(per_session) // untuk murid privat

  /// BR-04.6: murid dengan invoice overdue > 14 hari tidak boleh dijadwalkan
  /// sesi baru. null = tidak disuspend. Pencabutan adalah keputusan admin,
  /// bukan efek otomatis pelunasan, jadi cron tidak pernah mengosongkannya.
  suspendedAt      DateTime?
  suspensionReason String?

  /// NFR-6: akun yang sudah dianonimkan. Barisnya TIDAK dihapus karena
  /// invoice, charge, earning, dan audit log menahannya lewat foreign key
  /// (onDelete: Restrict) — dan BR-10.4 memang mewajibkan jejak itu bertahan.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                       UserRole[]
  children                    ParentStudent[]            @relation("children")
  parents                     ParentStudent[]            @relation("parents")
  teacherProfile              TeacherProfile?
  sessionsAsTeacher           Session[]                  @relation("SessionTeacher")
  sessionsAsSubstitute        Session[]                  @relation("SessionSubstitute")
  sessionsAsStudent           Session[]                  @relation("SessionStudent")
  privateAssignmentsAsTeacher PrivateAssignment[]        @relation("PrivateAssignmentTeacher")
  privateAssignmentsAsStudent PrivateAssignment[]        @relation("PrivateAssignmentStudent")
  teacherRequestsAsStudent    TeacherRequest[]           @relation("TeacherRequestStudent")
  teacherRequestsAsTeacher    TeacherRequest[]           @relation("TeacherRequestTeacher")
  recurringSchedulesAsTeacher PrivateRecurringSchedule[] @relation("RecurringScheduleTeacher")
  recurringSchedulesAsStudent PrivateRecurringSchedule[] @relation("RecurringScheduleStudent")
  studentBreaksAsStudent      StudentBreak[]             @relation("StudentBreakStudent")
  studentBreaksAsTeacher      StudentBreak[]             @relation("StudentBreakTeacher")
  enrollments                 Enrollment[]
  notifications               Notification[]
  customRate                  StudentCustomRate?
  charges                     SessionCharge[]
  invoices                    Invoice[]
  earnings                    SessionEarning[]
  payouts                     Payout[]
  teacherLeavesAsTeacher      TeacherLeave[]             @relation("TeacherLeaveTeacher")
  leaveCoveragesAsStudent     TeacherLeaveCoverage[]     @relation("LeaveCoverageStudent")
  leaveCoveragesAsSubstitute  TeacherLeaveCoverage[]     @relation("LeaveCoverageSubstitute")
  deletionRequests            AccountDeletionRequest[]
}

model Role {
  id    Int        @id @default(autoincrement())
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model ParentStudent {
  parentId  String
  studentId String
  relation  Relation
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  parent    User     @relation("parents", fields: [parentId], references: [id])
  student   User     @relation("children", fields: [studentId], references: [id])

  @@id([parentId, studentId])
  // Primary key hanya mengindeks prefix parentId; pencarian "siapa orang tua
  // murid ini" (halaman detail murid, ownership guard) butuh index sendiri.
  @@index([studentId])
}

model TeacherProfile {
  userId            String   @id
  bio               String?
  qualifications    String?
  sanadInfo         String?
  specialties       String[]
  acceptsPrivate    Boolean  @default(false)
  acceptingStudents Boolean  @default(true)
  yearsExperience   Int?
  revenueSharePct   Decimal  @default(60.00) @db.Decimal(5, 2)
  user              User     @relation(fields: [userId], references: [id])
}

// ===================== COURSE (fondasi fase 2) =====================

model Course {
  id                   String       @id @default(uuid())
  name                 String
  slug                 String       @unique
  description          String?
  levelNumber          Int?
  deliveryType         String // periodic | self_paced | public_kajian
  prerequisiteCourseId String?
  isActive             Boolean      @default(true)
  classGroups          ClassGroup[]
}

model AcademicPeriod {
  id                String       @id @default(uuid())
  name              String
  startDate         DateTime     @db.Date
  endDate           DateTime     @db.Date
  enrollmentOpenAt  DateTime?
  enrollmentCloseAt DateTime?
  isActive          Boolean      @default(true)
  classGroups       ClassGroup[]
}

model ClassGroup {
  id          String         @id @default(uuid())
  courseId    String
  periodId    String
  name        String
  capacity    Int            @default(15)
  price       Decimal        @db.Decimal(12, 2)
  status      String         @default("open") // open | closed | archived
  course      Course         @relation(fields: [courseId], references: [id])
  period      AcademicPeriod @relation(fields: [periodId], references: [id])
  sessions    Session[]
  enrollments Enrollment[]
}

model Enrollment {
  id           String     @id @default(uuid())
  studentId    String
  classGroupId String
  status       String     @default("active") // active | completed | dropped | suspended
  finalGrade   Decimal?   @db.Decimal(5, 2)
  student      User       @relation(fields: [studentId], references: [id])
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])

  @@unique([studentId, classGroupId])
}

// ===================== SESSIONS (inti) =====================

model Session {
  id                  String      @id @default(uuid())
  type                SessionType
  classGroupId        String? // untuk regular
  teacherId           String? // untuk private
  studentId           String? // untuk private
  substituteTeacherId String?

  title           String?
  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  meetingUrl      String?
  meetingProvider String? // zoom | google_meet | builtin
  recordingUrl    String?

  status      SessionStatus @default(scheduled)
  isMakeupFor String? // id sesi yang digantikan
  isEmergency Boolean       @default(false)
  notes       String?
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  classGroup ClassGroup? @relation(fields: [classGroupId], references: [id])
  teacher    User?       @relation("SessionTeacher", fields: [teacherId], references: [id])
  substitute User?       @relation("SessionSubstitute", fields: [substituteTeacherId], references: [id])
  student    User?       @relation("SessionStudent", fields: [studentId], references: [id])

  attendances        SessionAttendance[]
  grades             SessionGrade[]
  feedbacks          SessionFeedback[]
  charge             SessionCharge?
  earning            SessionEarning?
  rescheduleRequests RescheduleRequest[]
  reminders          SessionReminder[]

  // Idempotensi generator (PRD F-2a): satu murid tidak mungkin punya dua
  // sesi pada instan yang sama, jadi aturannya ditegakkan di level DB,
  // bukan hanya lewat pengecekan sebelum insert. Sesi reguler punya
  // studentId NULL dan Postgres menganggap NULL selalu berbeda, sehingga
  // tidak ikut terkena. Menggantikan @@index([studentId, scheduledAt])
  // karena unique sudah membuat indeksnya sendiri.
  @@unique([studentId, scheduledAt])
  @@index([classGroupId, scheduledAt])
  @@index([teacherId, scheduledAt])
  @@index([scheduledAt])
}

model SessionAttendance {
  id                  String           @id @default(uuid())
  sessionId           String
  studentId           String
  status              AttendanceStatus @default(no_info)
  excuseReason        String?
  excuseAttachmentUrl String?
  markedAt            DateTime?
  markedBy            String?
  session             Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model GradeCriterion {
  id          Int            @id @default(autoincrement())
  /// Unik supaya seed rubrik bisa dijalankan berulang tanpa menggandakan
  /// kriteria: Makharijul Huruf, Sifatul Huruf, Tajwid, Kelancaran.
  name        String         @unique
  description String?
  maxScore    Decimal        @default(100) @db.Decimal(5, 2)
  scope       String         @default("both") // regular | private | both
  grades      SessionGrade[]
}

model SessionGrade {
  id          String         @id @default(uuid())
  sessionId   String
  studentId   String
  criterionId Int
  score       Decimal        @db.Decimal(5, 2)
  assessorId  String
  session     Session        @relation(fields: [sessionId], references: [id])
  criterion   GradeCriterion @relation(fields: [criterionId], references: [id])

  @@unique([sessionId, studentId, criterionId])
}

model SessionFeedback {
  id           String   @id @default(uuid())
  sessionId    String
  studentId    String
  teacherId    String
  strengths    String?
  improvements String?
  nextTarget   String?
  audioNoteUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  session      Session  @relation(fields: [sessionId], references: [id])

  // Satu feedback per murid per sesi: guru yang mengirim ulang sedang
  // memperbaiki catatannya, bukan menambah catatan kedua.
  @@unique([sessionId, studentId])
}

/// Catatan bahwa satu pengingat sudah dikirim. Unique (sessionId, kind)
/// membuat pengiriman ganda mustahil di level DB, bukan hanya lewat
/// pengecekan sebelum insert — cron pengingat berjalan tiap beberapa menit
/// dan dua eksekusi bisa saja bertumpuk.
model SessionReminder {
  id        String       @id @default(uuid())
  sessionId String
  kind      ReminderKind
  sentAt    DateTime     @default(now())
  session   Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, kind])
}

// ===================== PRIVATE SCHEDULING =====================

model PrivateRecurringSchedule {
  id              String    @id @default(uuid())
  teacherId       String
  studentId       String
  dayOfWeek       Int // 0=Minggu .. 6=Sabtu
  startTime       String // format "16:00" (waktu lokal timezone user)
  durationMinutes Int
  meetingUrl      String?
  isActive        Boolean   @default(true)
  effectiveFrom   DateTime? @db.Date
  effectiveUntil  DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  teacher User @relation("RecurringScheduleTeacher", fields: [teacherId], references: [id])
  student User @relation("RecurringScheduleStudent", fields: [studentId], references: [id])

  @@unique([teacherId, studentId, dayOfWeek, startTime])
  @@index([teacherId, isActive])
  @@index([studentId, isActive])
}

model StudentBreak {
  id         String               @id @default(uuid())
  studentId  String
  teacherId  String
  startDate  DateTime             @db.Date
  endDate    DateTime             @db.Date
  reason     String?
  status     SimpleApprovalStatus @default(pending)
  reviewNote String? // alasan penolakan, diisi guru/admin saat menolak
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @default(now()) @updatedAt

  student User @relation("StudentBreakStudent", fields: [studentId], references: [id])
  teacher User @relation("StudentBreakTeacher", fields: [teacherId], references: [id])

  @@index([teacherId, status])
  @@index([studentId, status])
}

/// Cuti guru, pendek maupun panjang (BR-06, roadmap "Leave management").
///
/// Cuti pendek (BR-06.1) tidak butuh apa pun di sini selain baris riwayat —
/// guru cukup meliburkan sesi satu per satu lewat aksi status sesi biasa.
/// Baris ini betul-betul dipakai hanya untuk cuti panjang (type=long):
/// koordinasi per-murid ada di TeacherLeaveCoverage, bukan di sini, karena
/// BR-06.3 mensyaratkan SETIAP orang tua memilih sendiri (substitute atau
/// pause) — satu guru cuti bisa punya sepuluh murid dengan sepuluh
/// keputusan berbeda, bukan satu keputusan untuk semuanya.
model TeacherLeave {
  id                String      @id @default(uuid())
  teacherId         String
  type              LeaveType
  reason            String
  startDate         DateTime    @db.Date
  endDate           DateTime?   @db.Date
  status            LeaveStatus @default(pending)
  approvedBy        String?
  approvedAt        DateTime?
  /// Guru mengajukan "kembali aktif" (PRD F-7a) — diisi saat pengajuan
  /// masuk, dibaca oleh endpoint approve-return, dikosongkan lagi kalau
  /// admin menolaknya (guru boleh mengajukan ulang).
  returnRequestedAt DateTime?
  /// Diisi saat guru mengajukan "kembali aktif" dan admin menyetujuinya.
  endedAt           DateTime?
  createdAt         DateTime    @default(now())

  teacher   User                   @relation("TeacherLeaveTeacher", fields: [teacherId], references: [id])
  coverages TeacherLeaveCoverage[]

  @@index([teacherId, status])
}

/// Keputusan SATU keluarga atas cuti panjang guru anaknya (BR-06.3/06.4).
/// Dibuat satu baris per PrivateAssignment aktif begitu admin menyetujui
/// cuti panjang, dengan choice masih null — orang tua yang mengisinya.
model TeacherLeaveCoverage {
  id                  String    @id @default(uuid())
  leaveId             String
  assignmentId        String
  studentId           String
  /// null = orang tua belum memilih. "substitute" | "pause" sesudahnya.
  choice              String?
  substituteTeacherId String?
  decidedBy           String?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())

  leave      TeacherLeave      @relation(fields: [leaveId], references: [id])
  assignment PrivateAssignment @relation(fields: [assignmentId], references: [id])
  student    User              @relation("LeaveCoverageStudent", fields: [studentId], references: [id])
  substitute User?             @relation("LeaveCoverageSubstitute", fields: [substituteTeacherId], references: [id])

  @@unique([leaveId, assignmentId])
  @@index([studentId])
}

model RescheduleRequest {
  id        String @id @default(uuid())
  sessionId String

  /// Snapshot jadwal sesi SAAT usulan dibuat. Diperlukan karena approve
  /// mengubah scheduledAt sesi ke proposedAt — tanpa snapshot ini, riwayat
  /// yang sudah disetujui tidak bisa lagi menunjukkan "semula jam berapa",
  /// karena session.scheduledAt sudah menjadi nilai yang sama dengan
  /// proposedAt.
  originalScheduledAt DateTime

  requestedBy String
  proposedAt  DateTime
  reason      String?
  status      SimpleApprovalStatus @default(pending)
  respondedBy String?
  createdAt   DateTime             @default(now())
  session     Session              @relation(fields: [sessionId], references: [id])
}

model TeacherRequest {
  id                 String               @id @default(uuid())
  studentId          String
  teacherId          String? // NULL = percayakan admin
  preferredDurations Int[]
  preferredTimes     Json? // {mon: ["15:00-17:00"]}
  note               String?
  status             TeacherRequestStatus @default(pending)
  rejectReason       String? // wajib diisi saat status = rejected (divalidasi di API)
  handledBy          String? // id admin/guru yang me-review
  handledAt          DateTime?
  assignmentId       String?              @unique // terisi saat status = approved
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  student    User               @relation("TeacherRequestStudent", fields: [studentId], references: [id])
  teacher    User?              @relation("TeacherRequestTeacher", fields: [teacherId], references: [id])
  assignment PrivateAssignment? @relation(fields: [assignmentId], references: [id])

  @@index([status, teacherId])
  @@index([studentId, createdAt])
}

/// Penugasan murid privat ke guru. Dibuat saat TeacherRequest di-approve dan
/// menjadi sumber kebenaran relasi guru-murid privat SEBELUM ada jadwal
/// (PRD F-1: murid tetap terdaftar walau recurring schedule ditunda).
model PrivateAssignment {
  id        String                  @id @default(uuid())
  teacherId String
  studentId String
  level     String? // level awal murid privat — bebas, tidak terikat course reguler
  status    PrivateAssignmentStatus @default(active)
  notes     String?
  startedAt DateTime                @default(now())
  endedAt   DateTime?
  createdBy String? // id admin/guru yang menyetujui
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  teacher        User                   @relation("PrivateAssignmentTeacher", fields: [teacherId], references: [id])
  student        User                   @relation("PrivateAssignmentStudent", fields: [studentId], references: [id])
  request        TeacherRequest?
  leaveCoverages TeacherLeaveCoverage[]

  // Satu baris per pasangan guru-murid: approve ulang me-reaktifkan baris yang sama.
  @@unique([teacherId, studentId])
  @@index([teacherId, status])
  @@index([studentId, status])
}

// ===================== PRICING & BILLING =====================

model PricingTier {
  id              String  @id @default(uuid())
  durationMinutes Int     @unique
  price           Decimal @db.Decimal(12, 2)
  isActive        Boolean @default(true)
}

model StudentCustomRate {
  studentId   String @id
  customPrice Json // {30: 50000, 45: 70000, 60: 90000} (rupiah)
  student     User   @relation(fields: [studentId], references: [id])
}

model SessionCharge {
  id              String        @id @default(uuid())
  sessionId       String        @unique // idempotency: 1 sesi = 1 charge
  studentId       String
  durationMinutes Int
  amount          Decimal       @db.Decimal(12, 2)
  status          ChargeStatus  @default(pending)
  createdAt       DateTime      @default(now())
  session         Session       @relation(fields: [sessionId], references: [id])
  student         User          @relation(fields: [studentId], references: [id])
  invoiceItems    InvoiceItem[]

  /// Cron bundel bulanan mencari charge `pending` milik satu murid dalam
  /// rentang tanggal; itulah bentuk indeks ini.
  @@index([studentId, status, createdAt])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  studentId     String
  periodId      String? // untuk reguler (fase 2)
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(draft)
  paidAt        DateTime?

  /// BR-04.7: invoice yang salah di-void, tidak dihapus. Siapa dan kapan
  /// tercatat di AuditLog; alasannya di sini supaya ikut terbaca murid.
  voidReason String?
  voidedAt   DateTime?

  createdAt DateTime      @default(now())
  student   User          @relation(fields: [studentId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  /// Cron harian menyapu invoice yang lewat due date, dan halaman tagihan
  /// selalu menyaring per murid — dua pola query itu yang diindeks.
  @@index([status, dueDate])
  @@index([studentId, status])
}

model InvoiceItem {
  id              String         @id @default(uuid())
  invoiceId       String
  description     String
  sessionChargeId String?        @unique
  amount          Decimal        @db.Decimal(12, 2)
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sessionCharge   SessionCharge? @relation(fields: [sessionChargeId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  status    PaymentStatus @default(pending)

  /// Nomor rujukan yang unik lintas kanal: order_id Midtrans untuk Snap,
  /// nomor rujukan bank untuk transfer manual. Unique-nya yang membuat
  /// webhook Midtrans idempotent — notifikasi yang sama tidak pernah
  /// melahirkan baris kedua. NULL boleh berulang di Postgres, jadi
  /// pembayaran manual tanpa nomor rujukan tetap bisa disimpan.
  reference String? @unique

  /// Token Snap yang sudah diterbitkan, dipakai ulang selama masih pending
  /// agar satu invoice tidak menumpuk transaksi gantung di sisi Midtrans.
  gatewayToken String?

  proofUrl   String?
  note       String?
  verifiedBy String?
  verifiedAt DateTime?

  /// Diisi hanya ketika pembayaran benar-benar sah (verified). Berbeda dari
  /// skema awal yang selalu mengisinya, karena baris pending belum berarti
  /// uang sudah diterima.
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
}

// ===================== EARNINGS & PAYOUT =====================

model SessionEarning {
  id          String        @id @default(uuid())
  sessionId   String        @unique
  teacherId   String
  amount      Decimal       @db.Decimal(12, 2)
  status      EarningStatus @default(pending)
  createdAt   DateTime      @default(now())
  session     Session       @relation(fields: [sessionId], references: [id])
  teacher     User          @relation(fields: [teacherId], references: [id])
  payoutItems PayoutItem[]

  /// Halaman upah guru dan antrean persetujuan admin sama-sama menyaring
  /// upah per guru dan per status; itulah bentuk indeks ini.
  @@index([teacherId, status])
  @@index([status, createdAt])
}

model Payout {
  id          String       @id @default(uuid())
  teacherId   String
  totalAmount Decimal      @db.Decimal(12, 2)
  status      PayoutStatus @default(requested)

  /// Catatan admin atas keputusannya. Wajib saat menolak, karena guru
  /// berhak tahu alasan pengajuannya tidak diproses.
  note        String?
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  paidAt      DateTime?
  processedBy String?

  teacher User         @relation(fields: [teacherId], references: [id])
  items   PayoutItem[]

  @@index([teacherId, status])
  @@index([status, requestedAt])
}

model PayoutItem {
  id               String         @id @default(uuid())
  payoutId         String
  sessionEarningId String         @unique
  payout           Payout         @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  sessionEarning   SessionEarning @relation(fields: [sessionEarningId], references: [id])

  @@index([payoutId])
}

// ===================== NOTIFICATION & AUDIT =====================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // session_cancelled, invoice_issued, feedback_new, dst
  title     String
  body      String?
  data      Json?
  channel   String    @default("in_app") // in_app | email
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  entity    String // Invoice, SessionCharge, Payout, Session
  entityId  String
  action    String // status_change, void, approve, dst
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ===================== KAJIAN (fase 3, fondasi) =====================

model KajianEvent {
  id            String               @id @default(uuid())
  title         String
  description   String?
  speaker       String?
  scheduledAt   DateTime
  meetingUrl    String?
  recordingUrl  String?
  registrations KajianRegistration[]
}

model KajianRegistration {
  eventId  String
  userId   String
  attended Boolean     @default(false)
  event    KajianEvent @relation(fields: [eventId], references: [id])

  @@id([eventId, userId])
}

// ===================== OBSERVABILITY (fase 2 pengerasan) =====================

/// Riwayat eksekusi cron. Dipakai /api/health untuk melaporkan "cron terakhir
/// jalan" (NFR-4) dan dipakai admin untuk melihat kenapa sesi tidak muncul.
model CronRun {
  id         String    @id @default(uuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    Json?
  error      String?

  /// Pola query satu-satunya: sukses terakhir per job.
  @@index([job, ok, startedAt])
}

/// Permintaan hapus akun dengan masa tenggang (NFR-6).
/// Tenggang ada supaya salah klik pada akun yang masih punya tagihan
/// terbuka tidak langsung menghapus identitas pembayarnya.
model AccountDeletionRequest {
  id            String    @id @default(uuid())
  userId        String
  /// Siapa yang MENGAJUKAN. null = akun itu sendiri (layanan mandiri).
  /// Terisi bila orang tua mengajukan atas nama anaknya — jejak itu wajib
  /// ada untuk permintaan penghapusan data yang bersifat legal (NFR-6).
  requestedBy   String?
  requestedAt   DateTime  @default(now())
  /// null selama permintaan masih menunggu tinjauan admin: belum ada tanggal
  /// eksekusi yang bermakna. Diisi saat admin menyetujui, sehingga tenggang
  /// 7 hari berjalan dari KEPUTUSAN, bukan dari pengajuan. Query cron memakai
  /// `lte`, dan null tidak pernah cocok dengan itu — aman secara konstruksi.
  executeAfter  DateTime?
  status        String    @default("pending") // awaiting_admin | pending | cancelled | executed | blocked
  blockedBy     String?
  blockedReason String?
  executedAt    DateTime?
  user          User      @relation(fields: [userId], references: [id])

  /// Cron menyapu yang pending dan sudah lewat tenggang.
  @@index([status, executeAfter])
}
